# Override sdkconfig.defaults for Rust build
# Use default TWO_OTA partition table (no custom partitions.csv needed)
CONFIG_PARTITION_TABLE_CUSTOM=n
CONFIG_PARTITION_TABLE_TWO_OTA=y

# Enable driver components for MCPWM, ADC, GPIO
CONFIG_ESP_DRIVER_MCPWM_ENABLED=y
CONFIG_ESP_DRIVER_GPIO_ENABLED=y
CONFIG_ESP_DRIVER_ADC_ENABLED=y
CONFIG_ESP_ADC_ENABLED=y
CONFIG_ESP_DRIVER_I2S_ENABLED=y
